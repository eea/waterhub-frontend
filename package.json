{
  "name": "waterhub-frontend-dev",
  "description": "Copernicus Thematic Water Hub Volto frontend",
  "license": "MIT",
  "version": "1.0.0-alpha.0",
  "scripts": {
    "preinstall": "npx --yes only-allow pnpm",
    "start": "pnpm build:deps && VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto start",
    "start:prod": "pnpm --filter @plone/volto start:prod",
    "analyze": "BUNDLE_ANALYZE=true pnpm build",
    "build": "pnpm build:deps && VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto build",
    "build:deps": "pnpm --filter @plone/registry --filter @plone/components build",
    "develop": "pnpm dlx mrs-developer@2.2.0 missdev --no-config --output=packages --fetch-https",
    "lint": "VOLTOCONFIG=$(pwd)/volto.config.js eslint --max-warnings=0 'packages/volto-waterhub-frontend/src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "VOLTOCONFIG=$(pwd)/volto.config.js eslint --fix 'packages/volto-waterhub-frontend/src/**/*.{js,jsx,ts,tsx}'",
    "lint:ci": "VOLTOCONFIG=$(pwd)/volto.config.js eslint --max-warnings=0 -f checkstyle 'packages/volto-waterhub-frontend/src/**/*.{js,jsx,ts,tsx}' > eslint.xml",
    "prettier": "prettier --check 'packages/volto-waterhub-frontend/src/**/*.{js,jsx,ts,tsx,css,scss}'",
    "prettier:fix": "prettier --write 'packages/volto-waterhub-frontend/src/**/*.{js,jsx,ts,tsx,css,scss}'",
    "prettier:ci": "prettier --check 'packages/volto-waterhub-frontend/src/**/*.{js,jsx,ts,tsx,css,scss}'",
    "stylelint": "stylelint 'packages/volto-waterhub-frontend/src/**/*.{css,scss,less}' --allow-empty-input",
    "stylelint:fix": "stylelint 'packages/volto-waterhub-frontend/src/**/*.{css,scss,less}' --fix --allow-empty-input",
    "test": "pnpm --filter @eeacms/volto-waterhub-frontend exec vitest run --passWithNoTests",
    "typecheck": "pnpm --filter @eeacms/volto-waterhub-frontend exec tsc --noEmit",
    "check": "pnpm lint && pnpm prettier && pnpm stylelint && pnpm typecheck && pnpm test",
    "i18n": "pnpm --filter @eeacms/volto-waterhub-frontend i18n && VOLTOCONFIG=$(pwd)/volto.config.js pnpm --filter @plone/volto i18n",
    "cypress:run": "pnpm cypress:smoke",
    "cypress:smoke": "NODE_ENV=test CYPRESS_BASE_URL=http://localhost:3000 pnpm exec cypress run --config-file $(pwd)/cypress.config.js --spec $(pwd)/cypress/e2e/smoke.cy.js",
    "cypress:staging": "NODE_ENV=test CYPRESS_BASE_URL=https://staging.example.com pnpm exec cypress run --config-file $(pwd)/cypress.config.js --spec $(pwd)/cypress/e2e/acceptance.cy.js",
    "cypress:production": "NODE_ENV=test CYPRESS_BASE_URL=https://www.example.com pnpm exec cypress run --config-file $(pwd)/cypress.config.js --spec $(pwd)/cypress/e2e/acceptance.cy.js",
    "cypress:open": "NODE_ENV=test pnpm exec cypress open --config-file $(pwd)/cypress.config.js",
    "update": "make update",
    "status": "make status",
    "pull": "make pull"
  },
  "private": true,
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.overrides",
        "options": {
          "parser": "less"
        }
      }
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-idiomatic-order"
    ],
    "plugins": [
      "stylelint-prettier"
    ],
    "overrides": [
      {
        "files": [
          "**/*.less"
        ],
        "customSyntax": "postcss-less"
      },
      {
        "files": [
          "**/*.overrides"
        ],
        "customSyntax": "postcss-less"
      }
    ],
    "rules": {
      "prettier/prettier": true,
      "rule-empty-line-before": [
        "always-multi-line",
        {
          "except": [
            "first-nested"
          ],
          "ignore": [
            "after-comment"
          ]
        }
      ]
    },
    "ignoreFiles": "theme/themes/default/**/*.overrides"
  },
  "browserslist": [
    ">1%",
    "last 4 versions",
    "Firefox ESR",
    "not ie 11",
    "not dead"
  ],
  "engines": {
    "node": "^22 || ^24"
  },
  "dependencies": {
    "@sentry/cli": "1.77.3",
    "@eeacms/volto-eea-design-system": "workspace:*",
    "@eeacms/volto-eea-website-theme": "workspace:*",
    "@plone/volto": "workspace:*",
    "@plone/registry": "workspace:*",
    "@eeacms/volto-waterhub-frontend": "workspace:*"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.22.15",
    "@cypress/code-coverage": "^3.10.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "cypress": "13.17.0",
    "cypress-fail-fast": "^5.0.1",
    "compression-webpack-plugin": "10.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-react-app": "^7.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-babel-plugin-root-import": "^1.1.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "mrs-developer": "^2.2.0",
    "postcss-less": "6.0.0",
    "stylelint": "^16.3.1",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-prettier": "5.0.0",
    "wait-on": "^9.0.4"
  },
  "pnpm": {
    "overrides": {
      "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
      "@plone/babel-preset-razzle>chalk": "4.1.2",
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "react-refresh": "^0.14.2"
    },
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ],
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "core-js",
      "core-js-pure",
      "cypress",
      "es5-ext",
      "esbuild",
      "full-icu",
      "lightningcss-cli",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.20.0"
}
