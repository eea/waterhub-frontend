/*******************************
            Header
*******************************/

/*-------------------
       Top bar
--------------------*/

.top.bar {
  .ui.container {
    min-height: @computerTopSectionHeight;
  }

  .item {
    color: @white;
  }

  a,
  a:visited {
    color: @white;
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
  }

  .waterhub-hashtag,
  .waterhub-account {
    font-weight: @bold;
  }

  .waterhub-top-actions {
    display: flex;
    align-items: center;
    gap: @waterhubTopBarGap;
  }
}

/* Logged-in account: icon, name, chevron (see AccountMenu in Header.jsx) */
.waterhub-account-icon,
.waterhub-account-chevron {
  width: @waterhubAccountIconSize;
  height: @waterhubAccountIconSize;
  flex-shrink: 0;
}

/* Burger menu: inline, so the name shares a baseline with "/ Log out" */
.waterhub-account-user .waterhub-account-icon {
  margin-right: @waterhubAccountGap;
  vertical-align: text-bottom;
}

.waterhub-account-menu {
  position: relative;
}

.waterhub-account-toggle {
  display: inline-flex;
  align-items: center;
  padding: 0;
  border: none;
  background: none;
  color: inherit;
  cursor: pointer;
  font: inherit;
  gap: @waterhubAccountGap;
  line-height: 1.2;

  &:hover .waterhub-account-name,
  &:focus-visible .waterhub-account-name {
    text-decoration: underline;
  }

  &[aria-expanded='true'] .waterhub-account-chevron {
    transform: rotate(180deg);
  }
}

.waterhub-account-dropdown {
  position: absolute;
  z-index: 1;
  top: calc(100% + @waterhubAccountMenuOffset);
  right: 0;
  min-width: @waterhubAccountMenuMinWidth;
  padding: @rem-space-2 0;
  margin: 0;
  background: @white;
  box-shadow: @waterhubAccountMenuShadow;
  list-style: none;
}

/* Beats `.top.bar a` (white) */
.top.bar .waterhub-account-dropdown a,
.top.bar .waterhub-account-dropdown a:visited {
  display: block;
  padding: @rem-space-2 @rem-space-4;
  color: @primaryColor;
  white-space: nowrap;

  &:hover,
  &:focus-visible {
    background: @waterhubAccountMenuHoverBackground;
  }
}

.waterhub-top-links ul {
  display: flex;
  padding: 0;
  margin: 0;
  gap: @waterhubTopBarGap;
  list-style: none;
}

.waterhub-top-search {
  display: flex;
  height: @waterhubSearchHeight;

  input {
    width: @waterhubSearchInputWidth;
    padding: 0 @rem-space-2;
    border: none;
    border-radius: 0;
    background: @white;
    color: @textColor;
    font-family: @pageFont;
    font-size: @waterhubBodyXSFontSize;

    &::placeholder {
      color: @waterhubTextMuted;
      font-style: italic;
    }
  }

  button {
    display: flex;
    width: @waterhubSearchButtonWidth;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: @darkPrimaryColor;
    cursor: pointer;
  }
}

/*-------------------
       Main bar
--------------------*/

.main.bar {
  border-bottom: 1px solid @waterhubBorder;
}

/* The brand column takes the free space (EEA gives it a fixed 4/16 column) */
@media only screen and (min-width: @computerBreakpoint) {
  .main.bar .main-bar-container > .ui.grid {
    flex-wrap: nowrap;

    > .column:first-child {
      display: flex;
      width: auto !important;
      min-width: 0;
      flex: 1 1 auto;
      align-items: center;
    }

    > .column:last-child {
      display: flex;
      width: auto !important;
      flex: 0 0 auto;
      align-items: center;
    }
  }
}

.main.bar .main-menu {
  height: 100%;
  align-items: center;
}

/* EEA adds @mainMenuGap only from 1200px and sets gap 0 below that, spacing
   items with padding, which we zero (Figma: the rule spans the label). 40px
   doesn't fit next to the brand at 992-1199px, so use a smaller gap there.
   Same selector as EEA's gap: 0, so this wins by source order */
@media only screen and (min-width: @computerBreakpoint) and (max-width: @largestSmallMonitor) {
  .main.bar .ui.container .ui.text.menu {
    gap: 0 @waterhubMainMenuCompactGap;
  }
}

/* Figma: 6px padding with the 3px rule inside it (39px item) */
.main-menu .item a {
  padding: 6px 0 3px;
}

/* Beats Semantic's `.ui.menu .item > a:not(.ui)` (line-height 1.3) */
.main.bar .main-menu .item > a:not(.ui) {
  line-height: 1.5;
}

.waterhub-brand {
  display: flex;
  align-items: center;
  gap: @waterhubBrandGap;

  .logo {
    display: flex;
  }
}

.waterhub-badge,
.waterhub-badge:visited {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  padding: 6px @rem-space-5;
  border-radius: @waterhubHubPillRadius;
  background: @primaryColor;
  color: @white;
  font-size: @waterhubHubPillFontSize;
  font-weight: @bold;
  letter-spacing: 0.02em;
  line-height: 1.5;
  text-transform: uppercase;
  white-space: nowrap;
}

.waterhub-badge:hover {
  background: @darkPrimaryColor;
  color: @white;
}

.main.bar .search-action {
  display: none;
}

.waterhub-menu-account {
  display: none;
}

/*-------------------
    Mobile header
--------------------*/

/* Figma: a brand bar with menu, hub pill and search, then the logo on its own
   row. Header.Main renders them in one row, so its wrappers are flattened
   (display: contents) and the pieces placed on a grid. Up to 991px, where
   EEA swaps the menu for the burger (Figma: 820px) */
@media only screen and (max-width: @largestTabletScreen) {
  /* Figma has no top bar on mobile */
  .eea.header .top.bar {
    display: none;
  }

  .main.bar {
    background: linear-gradient(@primaryColor @waterhubMobileBarHeight, @white @waterhubMobileBarHeight);

    > .ui.container.main-bar-container {
      height: auto;
    }
  }

  .main.bar .main-bar-container > .ui.grid {
    display: grid;
    align-items: center;
    grid-template-columns: @waterhubMobileActionSize 1fr @waterhubMobileActionSize;
    grid-template-rows: @waterhubMobileBarHeight auto;

    > .column,
    .waterhub-brand,
    .main-menu {
      display: contents;
    }

    .main-menu nav {
      display: none;
    }

    .burger-action.mobile,
    .search-action {
      display: flex;
      width: @waterhubMobileActionSize;
      height: @waterhubMobileActionSize;
      padding: 0;
      background: transparent;

      img,
      .header-search-icon {
        width: @waterhubMobileActionIconSize;
        height: @waterhubMobileActionIconSize;
      }
    }

    .burger-action.mobile {
      grid-column: 1;
      grid-row: 1;
    }

    .waterhub-badge {
      background: @waterhubMobileHubPillBackground;
      grid-column: 2;
      grid-row: 1;
      justify-self: center;

      &:hover {
        background: @waterhubMobileHubPillHoverBackground;
      }
    }

    .search-action {
      grid-column: 3;
      grid-row: 1;
    }

    .logo {
      justify-content: center;
      padding: @waterhubMobileLogoRowPadding 0;
      grid-column: span 3;
      grid-row: 2;
    }
  }

  /* Account links, moved into the burger menu (see useMobileMenuSlot in Header.jsx) */
  .waterhub-menu-account {
    display: block;
    padding-top: @rem-space-4;
    color: @white;
    font-size: @waterhubNavUtilityFontSize;
    font-weight: @bold;

    a,
    a:visited {
      color: @white;
      text-decoration: none;
    }

    a:hover,
    a:focus-visible {
      text-decoration: underline;
    }
  }

  .eea.header .main.bar .eea-logo {
    width: @waterhubMobileLogoWidth;
    max-width: 100%;
    height: auto;
  }
}
