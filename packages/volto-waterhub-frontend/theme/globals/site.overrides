/*******************************
       WaterHub tokens
*******************************/

:root {
  --color-brand: @waterhubBrand;
  --color-brand-strong: @waterhubBrandStrong;
  --color-brand-subtle: @waterhubBrandSubtle;
  --color-on-brand: @waterhubOnBrand;
  --color-text: @waterhubText;
  --color-text-muted: @waterhubTextMuted;
  --color-heading: @waterhubHeading;
  --color-heading-block: @waterhubHeadingBlock;
  --color-link: @waterhubLink;
  --color-link-hover: @waterhubLinkHover;
  --color-text-inverse: @waterhubTextInverse;
  --color-surface: @waterhubSurface;
  --color-surface-alt: @waterhubSurfaceAlt;
  --color-surface-brand: @waterhubSurfaceBrand;
  --color-surface-water: @waterhubSurfaceWater;
  --color-overlay-scrim: @waterhubOverlayScrim;
  --color-border: @waterhubBorder;
  --color-border-strong: @waterhubBorderStrong;
  --color-border-brand: @waterhubBorderBrand;
  --color-focus: @waterhubFocus;
  --color-success: @waterhubSuccess;
  --color-success-bg: @waterhubSuccessBg;
  --color-error: @waterhubError;
  --color-error-bg: @waterhubErrorBg;
  --color-warning: @waterhubWarning;
  --color-warning-bg: @waterhubWarningBg;
  --color-info: @waterhubInfo;
  --color-info-bg: @waterhubInfoBg;
  --text-body: @waterhubMobileBodyFontSize;
  --font-keyword: @waterhubKeywordFont;
}

@media only screen and (min-width: @tabletBreakpoint) {
  :root {
    --text-body: @waterhubBodyFontSize;
  }
}

/*******************************
       WaterHub content
*******************************/

#page-document,
#page-edit,
#page-add {
  font-size: var(--text-body);
}

#page-document .headline,
#page-edit .headline,
#page-add .headline {
  padding-bottom: @rem-space-3;
  border-bottom: 1px solid @waterhubBlockTitleRule;
  margin-bottom: @rem-space-5;
  color: @waterhubHeadingBlock;
  font-size: @waterhubBlockTitleFontSize;
  font-weight: @bold;
  letter-spacing: 0.01em;
  line-height: 1.5;
  text-transform: uppercase;
}

#page-document p a:not(.ui),
#page-document li a:not(.ui),
#page-document td a:not(.ui),
#page-edit p a:not(.ui),
#page-edit li a:not(.ui),
#page-edit td a:not(.ui),
#page-add p a:not(.ui),
#page-add li a:not(.ui),
#page-add td a:not(.ui) {
  font-weight: @bold;
  text-decoration: underline;
  text-underline-offset: 0.15em;
}

#page-document .documentDescription,
#page-edit .documentDescription,
#page-add .documentDescription {
  padding-left: @rem-space-5;
  border-left: 3px solid @waterhubBorderBrand;
  color: @waterhubTextLead;
  font-size: @font-size-3;
  font-weight: @normal;
  line-height: 1.6;
}

.ui.vertical.segment.breadcrumbs {
  background-color: @waterhubWater100;
}

.ui.form textarea {
  font-family: @pageFont;
}

/*******************************
        Form block (edit)
*******************************/

// The EEA theme raises the block selection outline (::before) to z-index auto,
// which covers the form block content in edit mode and swallows clicks on its
// fields and the "Add field" button.
.block .block.form::before {
  pointer-events: none;
}

/*******************************
   Friendly Captcha (form block)
*******************************/

.block.form .frc-captcha {
  border: 1px solid fade(@primaryColor, 25%);
  margin: 1rem 0;
  font-family: @pageFont;

  * {
    font-family: @pageFont;
  }

  .frc-icon {
    fill: @primaryColor;
    stroke: @primaryColor;
  }

  .frc-button {
    background-color: fade(@primaryColor, 10%);
    color: @primaryColor;

    &:hover {
      background-color: fade(@primaryColor, 20%);
    }

    &:focus {
      border-color: @primaryColor;
    }
  }

  .frc-progress::-webkit-progress-value {
    background: @primaryColor;
  }

  .frc-progress::-moz-progress-bar {
    background: @primaryColor;
  }
}
